  <releases>
    <release version="5.2.0" date="2026-11-16">
      <description><p>See GitHub releases for the full changelog.</p></description>
    </release>
  </releases>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
</component>
