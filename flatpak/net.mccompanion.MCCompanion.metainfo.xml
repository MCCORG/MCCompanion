  </screenshots>
  <launchable type="desktop-id">net.mccompanion.MCCompanion.desktop</launchable>
  <url type="homepage">https://mccompanion.net/</url>
  <url type="bugtracker">https://github.com/MCCORG/MCCompanion/issues</url>
