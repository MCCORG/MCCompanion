<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.mccompanion.MCCompanion</id>
  <name>MCCompanion</name>
  <summary>A Minecraft companion app</summary>
  <developer id="net.mccompanion">
    <name>MCCORG</name>
  </developer>
  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <categories>
    <category>Game</category>
    <category>Network</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>Minecraft</keyword>
    <keyword>servers</keyword>
    <keyword>skins</keyword>
    <keyword>wiki</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#0284c7</color>
    <color type="primary" scheme_preference="dark">#0369a1</color>
  </branding>
  <description>
    <p>
      MCCompanion is a feature-rich Minecraft companion application.
      Ping and monitor your servers, browse the wiki, manage skins, and more.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/MCCORG/MCCompanion/main/assets/linux-screenshots/mccompanion-home.png</image>
      <caption>Home dashboard</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MCCORG/MCCompanion/main/assets/linux-screenshots/mccompanion-connector.png</image>
      <caption>Server connector</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MCCORG/MCCompanion/main/assets/linux-screenshots/mccompanion-partners.png</image>
      <caption>Partners overview</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MCCORG/MCCompanion/main/assets/linux-screenshots/mccompanion-servertracker.png</image>
      <caption>Server tracker</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MCCORG/MCCompanion/main/assets/linux-screenshots/mccompanion-lookup.png</image>
      <caption>Player and server lookup</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MCCORG/MCCompanion/main/assets/linux-screenshots/mccompanion-skins.png</image>
      <caption>Skin viewer and manager</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MCCORG/MCCompanion/main/assets/linux-screenshots/mccompanion-wiki.png</image>
